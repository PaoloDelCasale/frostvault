# Common source root on the server. Example:
# /srv/frostvault/sources/example-vault
# Application paths are fixed at /sources and /sources/managed (issue #148).
# SOURCES_ROOT is only a Compose host-path substitution.
SOURCES_ROOT=/srv/frostvault/sources

# Container process identity. Defaults match Unraid nobody:users (99:100).
# Host vault directories and ./data must be writable by this UID:GID; the
# entrypoint never chowns /sources. See docs/filesystem-permissions.md.
PUID=99
PGID=100

# Web panel: bind to 127.0.0.1 and expose it through a reverse proxy or Tailscale
APP_PORT=8080

# Set true behind HTTPS (production). When true, the app fails to start unless
# ALLOWED_HOSTS and TRUSTED_PROXIES are configured (fail-closed hardening).
COOKIE_SECURE=false

# HTTP /docs, /redoc and /openapi.json are off by default. Enable only in an
# isolated development deployment; this is anonymous, not Session-protected.
# app.openapi() and scripts/export_openapi.py work without this opt-in.
API_DOCS_ENABLED=false
# Optional independent scraper secret: empty = /metrics returns 404; when set,
# require Authorization: Bearer (missing/invalid = 401). Never use Owner/OIDC
# credentials, pass it in a URL, or commit a real value. See README.md#http-diagnostics.
METRICS_TOKEN=

# Built React SPA directory (Vite output). The image builds this; for a native
# run: cd frontend && npm ci && npm run build
FRONTEND_DIST_DIR=

# Optional email. All of HOST, FROM_ADDRESS and TO_ADDRESS must be non-empty.
# Without them events still reach the notification center. Restart after changes.
# Canonical application URL for email links (optional; no credentials).
APP_PUBLIC_URL=https://frostvault.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_TO_ADDRESS=
# STARTTLS except on port 465 (implicit TLS). False only for trusted local relays.
SMTP_USE_TLS=true

# Host/origin hardening. Comma-separated hostnames the app answers to; requests
# with any other Host header are rejected and allowed origins are derived from
# these hosts. Required when COOKIE_SECURE=true. Use bare ASCII hostnames/IPv4,
# not URLs, ports or wildcards. The local image readiness probe sends the first
# safe entry as Host without contacting it; no loopback exception is needed.
# See README.md#container-readiness. Example:
# ALLOWED_HOSTS=frostvault.example.com
ALLOWED_HOSTS=

# App client-IP trust: comma-separated proxy IPs/CIDRs. Required when
# COOKIE_SECURE=true. Use only actual proxies as seen by FrostVault, e.g.
# TRUSTED_PROXIES=172.30.0.2/32 (illustrative; inspect your own topology).
# Uvicorn may already have rewritten the ASGI client; this setting is NOT a
# veto on Uvicorn's trust. Keep both explicit lists below narrow and aligned.
TRUSTED_PROXIES=

# Uvicorn scheme AND client-IP trust (not an app setting). Behind TLS termination
# set this separately to the same actual proxies, e.g.
# FORWARDED_ALLOW_IPS=172.30.0.2/32. There is no automatic derivation.
# Empty means no forwarded-header trust; unset Uvicorn defaults to loopback.
# Without the proxy here, OIDC redirect_uri stays http even with COOKIE_SECURE.
# Never use * or all Docker/LAN networks. See docs/traefik.md before deployment.
FORWARDED_ALLOW_IPS=

# Reauthentication window (seconds) for the Recovery Kit download and
# «Elimina dal cloud» (cloud archive/purge). Minimum 60.
REAUTH_WINDOW_SECONDS=600

# The owner's emergency password (BOOTSTRAP_ADMIN_PASSWORD) is accepted only
# from loopback plus these LAN CIDRs; it is refused from anywhere else. Leave
# empty for loopback-only (127.0.0.0/8 and ::1); there is no allow-all value.
# Comma-separated, e.g. BREAK_GLASS_ALLOWED_CIDRS=192.168.1.0/24,2001:db8::/32
BREAK_GLASS_ALLOWED_CIDRS=

# OIDC sign-in for the owner (e.g. Pocket ID), configured only here. The first
# successful login binds the provider subject to the owner; any other subject
# is refused. Reauthentication steps up via prompt=login.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_LOGIN_TTL_SECONDS=600

# The single owner. Created on first start and re-applied at every start: the
# password is the emergency password for LAN sign-in (see above), and changing
# it revokes existing sessions. The owner has no username: the variable only
# marks the credentials as configured and the password alone signs in.
BOOTSTRAP_ADMIN_USERNAME=example-user
BOOTSTRAP_ADMIN_PASSWORD=REPLACE-WITH-A-LONG-PASSWORD
BOOTSTRAP_ADMIN_DISPLAY_NAME=Example User

# PostgreSQL 16 is required in production, development and tests.
# Optional DATABASE_URL (libpq DSN/URI) overrides corresponding PG* values;
# keep it secret when it contains credentials. Empty/unset uses PG* below.
# Existing PostgreSQL server. If PostgreSQL runs in a container on the same
# Docker network, set PGHOST to that container's service name.
PGHOST=host.docker.internal
PGPORT=5432
PGDATABASE=frostvault
PGUSER=frostvault
PGPASSWORD=REPLACE-WITH-A-LONG-PASSWORD

# AWS
AWS_ACCESS_KEY_ID=REPLACE-WITH-ACCESS-KEY
AWS_SECRET_ACCESS_KEY=REPLACE-WITH-SECRET-KEY
# Also selects the bundled AWS list prices used for cost estimates.
AWS_DEFAULT_REGION=eu-south-1

# Vault creation from the UI. Each generated UUID gets vaults/<uuid>/ in this
# shared S3 bucket. Leave empty to disable Vault creation.
VAULT_S3_BUCKET=example-bucket

# Fernet key for encrypted metadata backups (not Vault content). Generate with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this key outside the server; it is not included in metadata backups.
ARCHIVE_MASTER_KEY=

# There is no schema upgrade: on start an empty database is initialized and a
# database at another schema revision is refused before any write (ADR-0035).

# Encrypted metadata database backups (issue #15). See docs/metadata-backups.md.
# Artifacts are sealed with ARCHIVE_MASTER_KEY but never contain it.
METADATA_BACKUP_DIR=/data/backups
METADATA_BACKUP_RETENTION=14
METADATA_BACKUP_INTERVAL_SECONDS=86400
METADATA_BACKUP_VERIFY_INTERVAL_SECONDS=604800
METADATA_BACKUP_S3_PREFIX=system/backups/

# Retention of closed operational history (#596). See docs/history-retention.md.
# Only database rows are collected: never local files, cloud objects or backups.
JOB_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90

# Periodic checks
SCAN_INTERVAL_SECONDS=21600
# Weekly catalog audit against S3 versions/tags/storage classes (no Glacier restore).
AUDIT_INTERVAL_SECONDS=604800
# Update the catalog automatically when the local filesystem changes.
FILESYSTEM_WATCH_ENABLED=true
# Keep false on a Linux server; use true for Docker Desktop/Windows volumes.
FILESYSTEM_WATCH_FORCE_POLLING=false
FILESYSTEM_WATCH_DEBOUNCE_MS=1200
FILESYSTEM_WATCH_POLL_MS=2000
# Start new operations quickly; check Glacier recoveries less frequently to
# avoid unnecessary requests.
QUEUE_POLL_SECONDS=5
# Concurrent operations (upload, recovery, and local cleanup). Four is a
# conservative value; increase gradually up to eight if CPU, network, and S3
# limits allow it.
OPERATION_CONCURRENCY=4
# Optional upload bandwidth limit in KiB/s for the whole installation; empty or
# 0 means unlimited. Recoveries are never throttled.
BANDWIDTH_LIMIT_KIBPS=
# Deployment default for NEW upload admissions: s3_checksum (SHA256 ingestion
# proof) or read_back (full exact-version GET/SHA256). Vaults inherit or override.
# Missing provider proof falls back visibly to full download/retrieval/egress;
# contradictory proof blocks. Existing evidence and retry modes never change.
UPLOAD_VERIFICATION=s3_checksum
# Plain recover: parallel S3 range GETs (boto3 TransferManager).
S3_DOWNLOAD_MAX_CONCURRENCY=10
S3_DOWNLOAD_MULTIPART_THRESHOLD_MIB=8
S3_DOWNLOAD_MULTIPART_CHUNKSIZE_MIB=8
JOB_PROGRESS_MIN_INTERVAL_MS=500
JOB_POLL_SECONDS=900
RESTORE_DAYS=3
RESTORE_TIER=Bulk
# Restore Approval: a whole recovery request (file or folder) whose total
# size or restore Cost Estimate reaches either limit waits for one approval
# before any cloud restore. Checked once, when the request is queued.
RESTORE_HIGH_IMPACT_GIB=100
RESTORE_HIGH_IMPACT_EUR=10
# Maximum time, in seconds from queue admission, to approve a high-impact recovery
# request (default: 3600; values below 60 are clamped to 60, including 0).
# There is no unlimited/disabled value. At pending_until (inclusive) the entire still-pending
# request is cancelled, never auto-approved/restored. Approval after the deadline
# is refused even if the worker has not swept it yet. The worker performs expiry
# without S3 calls, also while local/cloud access is unavailable. Already-approved
# or restoring work is not expired. Changing this value affects new requests only.
RESTORE_APPROVAL_HOLD_SECONDS=3600

# Enable "Free local space" after directly checking the S3 copy.
