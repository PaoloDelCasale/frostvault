# Common source root on the server. Example:
# /srv/frostvault/sources/example-vault
SOURCES_ROOT=/srv/frostvault/sources

# Container process identity. Defaults match Unraid nobody:users (99:100).
# Host vault directories and ./data must be writable by this UID:GID; the
# entrypoint never chowns /sources. See docs/filesystem-permissions.md.
PUID=99
PGID=100

# Web panel: bind to 127.0.0.1 and expose it through a reverse proxy or Tailscale
APP_PORT=8080

# Set true behind HTTPS (production). When true, the app fails to start unless
# ALLOWED_HOSTS and TRUSTED_PROXIES are configured (fail-closed hardening).
COOKIE_SECURE=false

# Host/origin hardening. Comma-separated hostnames the app answers to; requests
# with any other Host header are rejected and allowed origins are derived from
# these hosts. Required when COOKIE_SECURE=true. Example:
# ALLOWED_HOSTS=frostvault.example.com
ALLOWED_HOSTS=

# Trusted reverse proxies as CIDRs. X-Forwarded-For/-Proto are honoured only
# when the direct peer is in this list; trusted hops are stripped to find the
# real client IP. Required when COOKIE_SECURE=true. Comma-separated, e.g.
# TRUSTED_PROXIES=127.0.0.1/32,10.0.0.0/8
TRUSTED_PROXIES=

# Reauthentication window (seconds) for sensitive actions such as admin
# mutations, invite creation, and freeing local space. Minimum 60.
REAUTH_WINDOW_SECONDS=600

# Break-glass Login (local admin password) is allowed from loopback plus these
# CIDRs. Leave empty for loopback-only; there is no allow-all. Comma-separated,
# e.g. BREAK_GLASS_ALLOWED_CIDRS=10.0.0.0/24,2001:db8::/32
BREAK_GLASS_ALLOWED_CIDRS=

# Optional generic OIDC provider for single sign-on. Leave OIDC_ISSUER empty to
# disable. When enabled (and COOKIE_SECURE=true) issuer, client id, and secret
# are all required. OIDC users step up for sensitive actions via prompt=login.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile

# First sign-in. The user is created only when the users table is empty.
BOOTSTRAP_ADMIN_USERNAME=example-user
BOOTSTRAP_ADMIN_PASSWORD=REPLACE-WITH-A-LONG-PASSWORD
BOOTSTRAP_ADMIN_DISPLAY_NAME=Example User

# First private vault assigned to the administrator. Create additional vaults
# from the administration panel.
BOOTSTRAP_VAULT_NAME=Example Vault
BOOTSTRAP_VAULT_SLUG=example-vault
BOOTSTRAP_VAULT_SOURCE_ROOT=/sources/example-vault

# Existing PostgreSQL server. If PostgreSQL runs in a container on the same
# Docker network, set PGHOST to that container's service name.
PGHOST=host.docker.internal
PGPORT=5432
PGDATABASE=frostvault
PGUSER=frostvault
PGPASSWORD=REPLACE-WITH-A-LONG-PASSWORD

# AWS
AWS_ACCESS_KEY_ID=REPLACE-WITH-ACCESS-KEY
AWS_SECRET_ACCESS_KEY=REPLACE-WITH-SECRET-KEY
AWS_DEFAULT_REGION=eu-south-1
S3_BUCKET=example-bucket
BOOTSTRAP_VAULT_S3_PREFIX=vaults/example-vault

# The crypt remote defined in config/rclone.conf
BOOTSTRAP_VAULT_RCLONE_REMOTE=frostvault-crypt
RCLONE_CONFIG=/config/rclone/rclone.conf

# Self-service vault creation (any authenticated user, not just the admin).
# The server generates each vault's storage identity (a UUID); it creates
# the local directory at VAULT_SOURCES_ROOT/<uuid> and stores objects under
# the S3 prefix vaults/<uuid>/ in VAULT_S3_BUCKET. VAULT_RCLONE_REMOTE must
# be a shared plain alias rooted at the bucket (not at a single vault prefix);
# FrostVault appends vaults/<uuid>/ to every plain Rclone object path.
# Leave VAULT_S3_BUCKET/VAULT_RCLONE_REMOTE empty to disable self-service
# creation (the admin panel keeps working either way).
VAULT_SOURCES_ROOT=/sources
VAULT_S3_BUCKET=example-bucket
VAULT_RCLONE_REMOTE=frostvault-plain

# Underlying S3 remote that per-vault crypt remotes wrap at runtime (issue #6).
# Typically the raw S3 backend section from rclone.conf (not a shared crypt
# remote). Required together with ARCHIVE_MASTER_KEY to create crypt vaults.
VAULT_RCLONE_BASE_REMOTE=frostvault-s3

# Fernet key that seals per-vault crypt secrets at rest. Generate with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep this key offline and separate from recovery exports and DB backups.
ARCHIVE_MASTER_KEY=

# Encrypted metadata database backups (issue #15). See docs/metadata-backups.md.
# Artifacts are sealed with ARCHIVE_MASTER_KEY but never contain it.
METADATA_BACKUP_DIR=/data/backups
METADATA_BACKUP_RETENTION=14
METADATA_BACKUP_INTERVAL_SECONDS=86400
METADATA_BACKUP_VERIFY_INTERVAL_SECONDS=604800
METADATA_BACKUP_S3_PREFIX=system/backups/

# Periodic checks
SCAN_INTERVAL_SECONDS=21600
# Weekly catalog audit against S3 versions/tags/storage classes (no Glacier restore).
AUDIT_INTERVAL_SECONDS=604800
# Update the catalog automatically when the local filesystem changes.
FILESYSTEM_WATCH_ENABLED=true
# Keep false on a Linux server; use true for Docker Desktop/Windows volumes.
FILESYSTEM_WATCH_FORCE_POLLING=false
FILESYSTEM_WATCH_DEBOUNCE_MS=1200
FILESYSTEM_WATCH_POLL_MS=2000
# Start new operations quickly; check Glacier recoveries less frequently to
# avoid unnecessary requests.
QUEUE_POLL_SECONDS=5
# Concurrent operations (upload, recovery, and local cleanup). Four is a
# conservative value; increase gradually up to eight if CPU, network, and S3
# limits allow it.
OPERATION_CONCURRENCY=4
JOB_POLL_SECONDS=900
RESTORE_DAYS=3
RESTORE_TIER=Bulk
RESTORE_HIGH_IMPACT_GIB=100
RESTORE_HIGH_IMPACT_EUR=10
RESTORE_APPROVAL_HOLD_SECONDS=3600

# Enable "Free local space" after directly checking the S3 copy.
ALLOW_LOCAL_DELETE=true
