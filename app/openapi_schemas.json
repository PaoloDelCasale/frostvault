{
  "schemas": {
    "VaultMoveEstimate": {
      "type": "object",
      "properties": {
        "target_class": {
          "type": "string"
        },
        "eligible_count": {
          "type": "integer"
        },
        "total_bytes": {
          "type": "integer"
        },
        "skipped": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "minimum_days": {
          "type": "integer"
        },
        "estimated_monthly_eur": {
          "type": "number"
        },
        "estimated_retrieval_eur": {
          "type": "number"
        },
        "pricing_effective_at": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "assumptions": {
          "type": "string"
        }
      },
      "required": [
        "target_class",
        "eligible_count",
        "total_bytes",
        "skipped",
        "minimum_days",
        "estimated_monthly_eur",
        "estimated_retrieval_eur",
        "pricing_effective_at",
        "region",
        "assumptions"
      ]
    },
    "VaultMovePreview": {
      "type": "object",
      "properties": {
        "vault_id": {
          "type": "integer"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/VaultMoveEstimate"
          }
        }
      },
      "required": [
        "vault_id",
        "targets"
      ]
    },
    "VaultMoveResponse": {
      "allOf": [
        {
          "$ref": "#/components/schemas/VaultMoveEstimate"
        },
        {
          "type": "object",
          "properties": {
            "group_id": {
              "type": "string"
            },
            "job_ids": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "item_count": {
              "type": "integer"
            }
          },
          "required": [
            "group_id",
            "job_ids",
            "item_count"
          ]
        }
      ]
    },
    "ApiErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "bad_request",
            "unauthenticated",
            "forbidden",
            "reauth_required",
            "not_found",
            "conflict",
            "invalid",
            "rate_limited",
            "failed",
            "upstream_failed",
            "unavailable"
          ],
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "message_key": {
          "type": "string"
        },
        "message_params": {
          "additionalProperties": {},
          "type": "object"
        }
      },
      "required": [
        "detail",
        "code",
        "message_key",
        "message_params"
      ],
      "type": "object"
    },
    "GlobPreviewResponse": {
      "additionalProperties": true,
      "properties": {
        "excluded": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "included": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "included",
        "excluded"
      ],
      "type": "object"
    },
    "LifecycleGuidedProfile": {
      "additionalProperties": false,
      "properties": {
        "transitions": {
          "items": {
            "$ref": "#/components/schemas/LifecycleTransition"
          },
          "type": "array"
        }
      },
      "type": "object",
      "required": [
        "transitions"
      ]
    },
    "LifecycleProfile": {
      "additionalProperties": false,
      "properties": {
        "transitions": {
          "items": {
            "$ref": "#/components/schemas/LifecycleTransition"
          },
          "type": "array"
        }
      },
      "required": [
        "transitions"
      ],
      "type": "object"
    },
    "LifecycleResponse": {
      "additionalProperties": true,
      "properties": {
        "guided_profiles": {
          "additionalProperties": {
            "$ref": "#/components/schemas/LifecycleGuidedProfile"
          },
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "profile": {
          "$ref": "#/components/schemas/LifecycleProfile"
        },
        "sync_pending": {
          "type": "boolean"
        }
      },
      "required": [
        "profile",
        "guided_profiles"
      ],
      "type": "object"
    },
    "LifecycleTransition": {
      "additionalProperties": true,
      "properties": {
        "days": {
          "type": "number"
        },
        "storage_class": {
          "type": "string"
        }
      },
      "required": [
        "days",
        "storage_class"
      ],
      "type": "object"
    },
    "OperationPolicy": {
      "additionalProperties": true,
      "properties": {
        "upload_verification": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "s3_checksum",
            "read_back",
            null
          ],
          "description": "Override for new upload admissions; null inherits deployment default."
        },
        "global_upload_verification": {
          "type": "string",
          "enum": [
            "s3_checksum",
            "read_back"
          ]
        },
        "effective_upload_verification": {
          "type": "string",
          "enum": [
            "s3_checksum",
            "read_back"
          ]
        },
        "auto_upload": {
          "type": "boolean"
        },
        "exclude_globs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include_globs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "local_release_after_days": {
          "enum": [
            90,
            180,
            365,
            730,
            null
          ],
          "type": [
            "integer",
            "null"
          ]
        },
        "stability_seconds": {
          "type": "number"
        },
        "fixed_exclude_globs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Fixed noise exclusions applied to every Vault; read only."
        }
      },
      "required": [
        "auto_upload",
        "local_release_after_days",
        "stability_seconds",
        "include_globs",
        "exclude_globs"
      ],
      "type": "object"
    },
    "StorageEstimateResponse": {
      "additionalProperties": true,
      "properties": {
        "assumptions": {
          "additionalProperties": {},
          "type": "object"
        },
        "currency": {
          "type": "string"
        },
        "estimated_cost_eur": {
          "type": "number"
        },
        "estimated_hours": {
          "type": [
            "number",
            "null"
          ]
        },
        "kind": {
          "const": "storage_month",
          "type": "string"
        },
        "pricing_effective_at": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "size_bytes": {
          "type": "number"
        },
        "storage_class": {
          "type": "string"
        },
        "tier": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "size_bytes",
        "storage_class",
        "tier",
        "estimated_cost_eur",
        "estimated_hours",
        "currency",
        "region",
        "pricing_effective_at",
        "assumptions"
      ],
      "type": "object"
    },
    "ExcludedFolder": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "rule"
      ]
    },
    "DiskListingEntry": {
      "type": "object",
      "additionalProperties": true,
      "description": "An entry read from disk inside an Excluded Folder: not catalogued, not protected.",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "file",
            "directory"
          ]
        },
        "size": {
          "type": [
            "integer",
            "null"
          ]
        },
        "modified_at": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "type",
        "size",
        "modified_at"
      ]
    },
    "ExcludedFolderListing": {
      "type": "object",
      "additionalProperties": true,
      "description": "One Vault level read from disk (#754): Excluded Folders of a catalogued level, or the entries of an Excluded Folder.",
      "properties": {
        "directory": {
          "type": "string"
        },
        "excluded_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "The folder rule that covers this directory; null outside an Excluded Folder."
        },
        "folders": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ExcludedFolder"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/DiskListingEntry"
          }
        },
        "total_entries": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "directory",
        "excluded_by",
        "folders",
        "entries",
        "total_entries",
        "truncated"
      ]
    },
    "VaultItemExclusionStatus": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "path": {
          "type": "string"
        },
        "is_directory": {
          "type": "boolean"
        },
        "own_rule": {
          "type": [
            "string",
            "null"
          ],
          "description": "path/** for a folder, the exact path for a file; null when the path holds glob characters."
        },
        "own_rule_present": {
          "type": "boolean"
        },
        "excluded": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other exclude globs that exclude the item."
        },
        "fixed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Fixed noise exclusions that match the item."
        },
        "not_included": {
          "type": "boolean",
          "description": "The include globs do not match the item."
        }
      },
      "required": [
        "path",
        "is_directory",
        "own_rule",
        "own_rule_present",
        "excluded",
        "rules",
        "fixed",
        "not_included"
      ]
    },
    "VaultInclusionPreview": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "path": {
          "type": "string"
        },
        "is_directory": {
          "type": "boolean"
        },
        "own_rule": {
          "type": [
            "string",
            "null"
          ],
          "description": "path/** for a folder, the exact path for a file; null when the path holds glob characters."
        },
        "own_rule_present": {
          "type": "boolean"
        },
        "excluded": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other exclude globs that exclude the item."
        },
        "fixed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Fixed noise exclusions that match the item."
        },
        "not_included": {
          "type": "boolean",
          "description": "The include globs do not match the item."
        },
        "includable": {
          "type": "boolean"
        },
        "folder_rule": {
          "type": "boolean",
          "description": "Removing the rule makes the Vault look inside the folder again with a full scan."
        },
        "files": {
          "type": [
            "integer",
            "null"
          ]
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "complete": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "False when the disk walk stopped at its time budget: the counts are a minimum."
        },
        "estimate": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/StorageEstimateResponse"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "is_directory",
        "own_rule",
        "own_rule_present",
        "excluded",
        "rules",
        "fixed",
        "not_included",
        "includable",
        "folder_rule",
        "files",
        "bytes",
        "complete",
        "estimate"
      ]
    }
  }
}
