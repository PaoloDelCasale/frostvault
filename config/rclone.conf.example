[frostvault-s3]
type = s3
provider = AWS
env_auth = true
region = eu-south-1
location_constraint = eu-south-1
no_check_bucket = true

# Shared plain remote for self-service vaults. Root the alias at the bucket;
# FrostVault appends each vault's s3_prefix (vaults/<uuid>/) to every object path.
[frostvault-plain]
type = alias
remote = frostvault-s3:example-bucket

# Legacy shared crypt example kept for older bootstrap vaults that still use
# plaintext object names (.bin suffix). Prefer per-vault crypt remotes for new
# vaults (issue #6).
# [frostvault-crypt]
# type = crypt
# remote = frostvault-s3:example-bucket/vaults/example-vault
# filename_encryption = off
# directory_name_encryption = false
# password = OBSCURED_PASSWORD_GENERATED_BY_RCLONE
