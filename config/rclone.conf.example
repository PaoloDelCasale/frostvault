[frostvault-s3]
type = s3
provider = AWS
env_auth = true
region = eu-south-1
location_constraint = eu-south-1
no_check_bucket = true

# Shared plain remote for legacy / bootstrap vaults. Self-service crypt vaults
# no longer share one static crypt remote: the application generates a unique
# password pair per vault, seals it with ARCHIVE_MASTER_KEY, and builds an
# ephemeral Rclone crypt remote with filename_encryption = standard and
# directory_name_encryption = true at runtime.
[frostvault-plain]
type = alias
remote = frostvault-s3:example-bucket/vaults/example-vault-plain

# Legacy shared crypt example kept for older bootstrap vaults that still use
# plaintext object names (.bin suffix). Prefer per-vault crypt remotes for new
# vaults (issue #6).
# [frostvault-crypt]
# type = crypt
# remote = frostvault-s3:example-bucket/vaults/example-vault
# filename_encryption = off
# directory_name_encryption = false
# password = OBSCURED_PASSWORD_GENERATED_BY_RCLONE
