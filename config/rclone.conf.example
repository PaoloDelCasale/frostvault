[frostvault-s3]
type = s3
provider = AWS
env_auth = true
region = eu-south-1
location_constraint = eu-south-1
no_check_bucket = true

# Shared plain remote for self-service vaults. Root the alias at the bucket;
# FrostVault appends each vault's s3_prefix (vaults/<uuid>/) to every object path.
[frostvault-plain]
type = alias
remote = frostvault-s3:example-bucket
