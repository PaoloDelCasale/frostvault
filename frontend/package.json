{
  "name": "frostvault-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ci": "vite build",
    "generate:api": "openapi-typescript openapi.json -o src/api/openapi.generated.ts && node scripts/generate-api-aliases.mjs",
    "check:generated": "git diff --exit-code -- openapi.json src/api/openapi.generated.ts src/api/types.ts",
    "typecheck": "tsc -b --pretty false",
    "typecheck:vitest": "tsc -p tsconfig.vitest.json --noEmit --pretty false",
    "typecheck:playwright": "tsc -p tsconfig.playwright.json --noEmit --pretty false",
    "lint": "eslint src tests e2e eslint.config.js vitest.config.ts vite.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@redocly/openapi-core": "^1.34.20",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12",
    "fast-uri@3": "^3.1.8",
    "ip-address@10": "^10.7.1",
    "js-yaml": "^4.3.2",
    "nanoid@3": "^3.3.18",
    "postcss-selector-parser": "^7.1.6",
    "proxy-addr": "^2.0.8",
    "qs@6": "^6.16.0",
    "source-map-js": "^1.2.2",
    "undici@7": "^7.29.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
