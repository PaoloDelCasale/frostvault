{
  "name": "frostvault-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ci": "vite build",
    "generate:api": "openapi-typescript openapi.json -o src/api/openapi.generated.ts && node scripts/generate-api-aliases.mjs",
    "check:generated": "git diff --exit-code -- openapi.json src/api/openapi.generated.ts src/api/types.ts",
    "typecheck": "tsc -b --pretty false",
    "typecheck:vitest": "tsc -p tsconfig.vitest.json --noEmit --pretty false",
    "typecheck:playwright": "tsc -p tsconfig.playwright.json --noEmit --pretty false",
    "lint": "eslint src tests e2e eslint.config.js vitest.config.ts vite.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@redocly/openapi-core": "^1.34.20",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12",
    "js-yaml": "^4.3.2",
    "minimatch@10": "^11.0.4",
    "nanoid@3": "^3.3.18",
    "source-map-js": "^1.2.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
